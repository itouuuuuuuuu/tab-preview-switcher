{
  "name": "tab-preview-switcher",
  "version": "0.1.0",
  "private": true,
  "description": "Chrome / Brave extension that switches tabs in most-recently-opened order while showing previews",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/chrome": "^0.2.2",
    "esbuild": "^0.28.1",
    "eslint": "^10.8.0",
    "eslint-plugin-unicorn": "^72.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
